{
  "name": "comment-on-github",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "An Action to comment on the relevant GitHub Release / PR / commit on push.",
  "main": "lib/main.js",
  "scripts": {
    "build": "tsc",
    "format": "prettier --write **/*.ts",
    "format-check": "prettier --check **/*.ts",
    "lint": "eslint src/**/*.ts",
    "pack": "rm -rf dist && ncc build --minify && mv dist/index.js dist/index.min.js",
    "all": "npm run build && npm run format && npm run lint && npm run pack",
    "test": "node --test test/*.test.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/daohoangson/comment-on-github.git"
  },
  "keywords": [
    "actions",
    "node",
    "setup"
  ],
  "author": "Dao Hoang Son <dao@hoangson.vn>",
  "license": "MIT",
  "engines": {
    "node": "^24"
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1",
    "serialize-error": "^13.0.2"
  },
  "devDependencies": {
    "@octokit/webhooks-types": "^7.6.1",
    "@types/node": "^24.19.2",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.57.1",
    "@vercel/ncc": "^0.45.0",
    "eslint": "^8.37.0",
    "eslint-plugin-github": "^4.7.0",
    "eslint-plugin-prettier": "^4.2.5",
    "js-yaml": "^4.1.0",
    "prettier": "^2.8.7",
    "typescript": "^5.0.3"
  },
  "overrides": {
    "eslint-plugin-escompat": "3.3.3"
  }
}
